# Environment Variables Template
# Copy this file to .env and fill in the actual values

# ============================================
# Google Analytics 4 Configuration
# ============================================
# Get your Measurement ID from: https://analytics.google.com/
# Format: G-XXXXXXXXXX (starts with G- followed by 10 characters)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Enable Google Analytics (set to 'true' to enable)
# Set to 'false' to disable during development
VITE_ENABLE_GA=true

# Enable GA debug mode (logs events to console)
# Set to 'true' during development to verify events are firing
VITE_ENABLE_GA_DEBUG=false

# Google Tag Manager (optional - if using GTM instead of direct GA)
# Get your Container ID from: https://tagmanager.google.com/
# Format: GTM-XXXXXX
# VITE_GTM_ID=GTM-XXXXXX

# ============================================
# Google Search Console Verification
# ============================================
# Get your verification code from: https://search.google.com/search-console
# This adds a meta tag for site ownership verification
VITE_GOOGLE_SITE_VERIFICATION=your_verification_code_here

# ============================================
# EmailJS Configuration (for contact form)
# ============================================
# Get these values from: https://www.emailjs.com/
# Service ID: Your EmailJS service ID
VITE_EMAILJS_SERVICE_ID=your_service_id

# Template ID: Your email template ID
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# Public Key: Your EmailJS public key
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ============================================
# SEO Configuration
# ============================================
# Production site URL (used for sitemap, canonical URLs, etc.)
VITE_SITE_URL=https://letysbukopie.com

# Enable SEO features in development (useful for testing)
VITE_ENABLE_SEO_DEV=false

# ============================================
# Social Media Configuration
# ============================================
# Facebook Page ID (for Open Graph insights)
VITE_FACEBOOK_PAGE_ID=your_facebook_page_id

# Instagram Business Account (for social meta tags)
VITE_INSTAGRAM_HANDLE=letysbukopie

# Twitter/X Handle (for Twitter Card meta tags)
VITE_TWITTER_HANDLE=letysbukopie

# ============================================
# Business Information (for Structured Data)
# ============================================
# Business phone number (format: +63-XXX-XXX-XXXX)
VITE_BUSINESS_PHONE=+63-917-123-4567

# Business email
VITE_BUSINESS_EMAIL=hello@letysbukopie.com

# Business founding year
VITE_BUSINESS_FOUNDING_YEAR=1976

# Business price range ($, $$, $$$)
VITE_BUSINESS_PRICE_RANGE=$$

# ============================================
# API Configuration
# ============================================
# Add any API keys or endpoints here
# VITE_API_BASE_URL=https://api.letysbukopie.com
# VITE_API_KEY=your_api_key_here
